# Postgres. Local dev default is a database on your local server.
DATABASE_URL=postgres://localhost:5432/tilemarket

# Stripe (test mode for development; never commit live keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public origin used to build Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Treemap tuning. Tile weight is total_cents ^ TREEMAP_EXPONENT.
# Lower = flatter board, higher = the top listing swallows more of it.
TREEMAP_EXPONENT=0.65

# Rotating daily salt base for IP hashing. Any long random string.
IP_HASH_SECRET=change-me-to-a-long-random-string

# Shared secret for the admin hide/remove route.
ADMIN_SECRET=change-me-too

# Optional. When set, favicons are stored in Vercel Blob instead of Postgres.
BLOB_READ_WRITE_TOKEN=
